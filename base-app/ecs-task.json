{
    "family": "trailblaze-auto-task",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "frontend",
            "image": "822038677286.dkr.ecr.ap-south-1.amazonaws.com/trailblaze-auto-frontend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "frontend-5173-tcp",
                    "containerPort": 5173,
                    "hostPort": 5173,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "CHOKIDAR_USEPOLLING",
                    "value": "true"
                },
                {
                    "name": "VITE_API_TARGET",
                    "value": "http://localhost:8000"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "dependsOn": [
                {
                    "containerName": "backend",
                    "condition": "START"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trailblaze-auto",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "frontend"
                }
            }
        },
        {
            "name": "nginx",
            "image": "822038677286.dkr.ecr.ap-south-1.amazonaws.com/trailblaze-auto-nginx:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "nginx-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "FRONTEND_HOST",
                    "value": "localhost"
                },
                {
                    "name": "BACKEND_HOST",
                    "value": "localhost"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "dependsOn": [
                {
                    "containerName": "frontend",
                    "condition": "START"
                },
                {
                    "containerName": "backend",
                    "condition": "START"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trailblaze-auto",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "nginx"
                }
            }
        },
        {
            "name": "backend",
            "image": "822038677286.dkr.ecr.ap-south-1.amazonaws.com/trailblaze-auto-backend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "backend-8000-tcp",
                    "containerPort": 8000,
                    "hostPort": 8000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "INIT_SCRIPT",
                    "value": "scripts.seed_public"
                },
                {
                    "name": "DEBUG",
                    "value": "1"
                },
                {
                    "name": "SQLITE_DB_NAME",
                    "value": "db_data/db.sqlite3"
                }
            ],
            "mountPoints": [
                {
                    "sourceVolume": "db_data",
                    "containerPath": "/app/db_data",
                    "readOnly": false
                }
            ],
            "volumesFrom": [],
            "dependsOn": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/trailblaze-auto",
                    "awslogs-region": "ap-south-1",
                    "awslogs-stream-prefix": "backend"
                }
            }
        }
    ],
    "taskRoleArn": "arn:aws:iam::822038677286:role/eventhive-ecs-task-role",
    "executionRoleArn": "arn:aws:iam::822038677286:role/ecsTaskExecutionRole",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "1024",
    "memory": "4096",
    "volumes": [
        {
            "name": "db_data"
        }
    ],
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}