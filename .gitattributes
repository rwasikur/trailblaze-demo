# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Force LF line endings for shell scripts and dockerfiles
*.sh text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
