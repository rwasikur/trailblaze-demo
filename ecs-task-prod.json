{
  "family": "trailblaze-auto-prod-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "frontend-nginx",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/trailblaze-auto-frontend-prod:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:80 || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trailblaze-auto",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "frontend-nginx",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "backend",
      "image": "<ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com/trailblaze-auto-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DEBUG",
          "value": "0"
        },
        {
          "name": "DB_HOST",
          "value": "localhost"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgres://trailblaze:trailblazepass@localhost:5432/trailblaze"
        },
        {
          "name": "JWT_SECRET",
          "value": "REPLACE_WITH_SECURE_SECRET"
        }
      ],
      "dependsOn": [
        {
          "containerName": "db",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trailblaze-auto",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "backend",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "db",
      "image": "public.ecr.aws/docker/library/postgres:15-alpine",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5432,
          "hostPort": 5432,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "trailblaze"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "trailblazepass"
        },
        {
          "name": "POSTGRES_DB",
          "value": "trailblaze"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "pg_isready -U trailblaze"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/trailblaze-auto",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "db",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecs-task-role",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
